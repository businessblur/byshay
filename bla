<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shay</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
–black: #080808;
–off-black: #111111;
–panel: #161616;
–border: #242424;
–gold: #C9A84C;
–gold-dim: rgba(201,168,76,0.15);
–white: #F4F1EC;
–gray: #888880;
–light: #C8C5BE;
}

html { scroll-behavior: smooth; }

body {
background: var(–black);
color: var(–white);
font-family: ‘Montserrat’, sans-serif;
font-weight: 300;
overflow-x: hidden;
cursor: none;
}

/* Custom cursor */
.cursor {
position: fixed;
width: 8px; height: 8px;
background: var(–gold);
border-radius: 50%;
pointer-events: none;
z-index: 9999;
transform: translate(-50%, -50%);
transition: transform 0.1s ease, width 0.3s ease, height 0.3s ease, opacity 0.3s ease;
}
.cursor-ring {
position: fixed;
width: 32px; height: 32px;
border: 1px solid rgba(201,168,76,0.4);
border-radius: 50%;
pointer-events: none;
z-index: 9998;
transform: translate(-50%, -50%);
transition: transform 0.15s ease, width 0.3s ease, height 0.3s ease;
}
body:has(a:hover) .cursor,
body:has(button:hover) .cursor { width: 14px; height: 14px; }

/* Nav */
nav {
position: fixed;
top: 0; left: 0; right: 0;
z-index: 100;
display: flex;
justify-content: space-between;
align-items: center;
padding: 28px 60px;
background: linear-gradient(to bottom, rgba(8,8,8,0.95), transparent);
}
.nav-logo {
font-family: ‘Cormorant Garamond’, serif;
font-size: 22px;
font-weight: 300;
letter-spacing: 8px;
color: var(–white);
text-decoration: none;
}
.nav-links {
display: flex;
gap: 40px;
list-style: none;
}
.nav-links a {
font-size: 10px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–gray);
text-decoration: none;
transition: color 0.3s;
}
.nav-links a:hover { color: var(–gold); }

/* Hero */
.hero {
min-height: 100vh;
display: flex;
flex-direction: column;
justify-content: center;
align-items: flex-start;
padding: 0 60px;
position: relative;
overflow: hidden;
}
.hero::before {
content: ‘’;
position: absolute;
top: -20%; right: -10%;
width: 600px; height: 600px;
background: radial-gradient(circle, rgba(201,168,76,0.06) 0%, transparent 70%);
pointer-events: none;
}
.hero-eyebrow {
font-size: 9px;
letter-spacing: 5px;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 28px;
opacity: 0;
animation: fadeUp 0.8s ease 0.2s forwards;
}
.hero-name {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(90px, 14vw, 160px);
font-weight: 300;
line-height: 0.9;
letter-spacing: -2px;
color: var(–white);
opacity: 0;
animation: fadeUp 0.9s ease 0.35s forwards;
}
.hero-name em {
font-style: italic;
color: var(–gold);
}
.hero-sub {
margin-top: 32px;
font-size: 12px;
letter-spacing: 2px;
color: var(–light);
max-width: 420px;
line-height: 2;
opacity: 0;
animation: fadeUp 0.9s ease 0.5s forwards;
}
.hero-cta {
margin-top: 52px;
display: flex;
align-items: center;
gap: 32px;
opacity: 0;
animation: fadeUp 0.9s ease 0.65s forwards;
}
.btn-primary {
font-family: ‘Montserrat’, sans-serif;
font-size: 10px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–black);
background: var(–gold);
border: none;
padding: 16px 36px;
cursor: none;
transition: opacity 0.3s, transform 0.3s;
text-decoration: none;
display: inline-block;
}
.btn-primary:hover { opacity: 0.85; transform: translateY(-1px); }
.btn-ghost {
font-size: 10px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–gray);
text-decoration: none;
transition: color 0.3s;
display: flex;
align-items: center;
gap: 10px;
}
.btn-ghost::after {
content: ‘→’;
font-size: 14px;
transition: transform 0.3s;
}
.btn-ghost:hover { color: var(–white); }
.btn-ghost:hover::after { transform: translateX(4px); }

.hero-line {
position: absolute;
right: 60px;
top: 50%;
transform: translateY(-50%);
display: flex;
flex-direction: column;
align-items: center;
gap: 12px;
opacity: 0;
animation: fadeIn 1.2s ease 1s forwards;
}
.hero-line span {
font-size: 8px;
letter-spacing: 4px;
writing-mode: vertical-rl;
text-transform: uppercase;
color: var(–gray);
}
.hero-line::after {
content: ‘’;
width: 1px;
height: 80px;
background: linear-gradient(to bottom, var(–gold), transparent);
}

/* Divider */
.divider {
display: flex;
align-items: center;
gap: 24px;
padding: 0 60px;
margin: 80px 0;
}
.divider::before, .divider::after {
content: ‘’;
flex: 1;
height: 1px;
background: var(–border);
}
.divider-text {
font-size: 8px;
letter-spacing: 5px;
text-transform: uppercase;
color: var(–gold);
white-space: nowrap;
}

/* Philosophy */
.philosophy {
padding: 0 60px 100px;
display: grid;
grid-template-columns: 1fr 1fr;
gap: 80px;
align-items: center;
}
.philosophy-quote {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(28px, 3.5vw, 44px);
font-weight: 300;
line-height: 1.4;
color: var(–white);
}
.philosophy-quote em {
font-style: italic;
color: var(–gold);
}
.philosophy-text p {
font-size: 13px;
line-height: 2;
color: var(–light);
margin-bottom: 20px;
}
.philosophy-text p:last-child { margin-bottom: 0; }

/* Tiers */
.tiers-section {
padding: 0 60px 120px;
}
.section-header {
margin-bottom: 60px;
}
.section-label {
font-size: 8px;
letter-spacing: 5px;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 16px;
}
.section-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(36px, 4vw, 52px);
font-weight: 300;
color: var(–white);
}
.tiers-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 2px;
}
.tier-card {
background: var(–panel);
padding: 48px 40px;
position: relative;
transition: background 0.4s;
border-top: 1px solid var(–border);
}
.tier-card:hover { background: #1c1c1c; }
.tier-card.featured {
background: var(–off-black);
border-top: 1px solid var(–gold);
}
.tier-card.featured::before {
content: ‘MOST PERSONAL’;
position: absolute;
top: -1px; right: 40px;
background: var(–gold);
color: var(–black);
font-size: 7px;
letter-spacing: 3px;
padding: 5px 12px;
font-weight: 600;
}
.tier-number {
font-size: 9px;
letter-spacing: 4px;
color: var(–gold);
margin-bottom: 24px;
display: block;
}
.tier-name-card {
font-family: ‘Cormorant Garamond’, serif;
font-size: 30px;
font-weight: 300;
color: var(–white);
margin-bottom: 8px;
}
.tier-price-card {
font-size: 13px;
color: var(–gold);
letter-spacing: 1px;
margin-bottom: 24px;
}
.tier-divider {
width: 40px;
height: 1px;
background: var(–border);
margin-bottom: 24px;
}
.tier-desc-card {
font-size: 12px;
line-height: 1.9;
color: var(–gray);
margin-bottom: 28px;
}
.tier-features {
list-style: none;
display: flex;
flex-direction: column;
gap: 12px;
}
.tier-features li {
font-size: 11px;
color: var(–light);
display: flex;
align-items: flex-start;
gap: 12px;
line-height: 1.6;
}
.tier-features li::before {
content: ‘—’;
color: var(–gold);
flex-shrink: 0;
margin-top: 1px;
}

/* Process */
.process-section {
padding: 0 60px 120px;
}
.process-steps {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 60px;
margin-top: 60px;
}
.step-number {
font-family: ‘Cormorant Garamond’, serif;
font-size: 64px;
font-weight: 300;
color: var(–border);
line-height: 1;
margin-bottom: 20px;
}
.step-title {
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–white);
margin-bottom: 16px;
}
.step-desc {
font-size: 12px;
line-height: 2;
color: var(–gray);
}

/* Contact / Closing */
.closing-section {
padding: 100px 60px;
text-align: center;
position: relative;
overflow: hidden;
}
.closing-section::before {
content: ‘’;
position: absolute;
top: 50%; left: 50%;
transform: translate(-50%, -50%);
width: 500px; height: 500px;
background: radial-gradient(circle, rgba(201,168,76,0.05) 0%, transparent 70%);
pointer-events: none;
}
.closing-eyebrow {
font-size: 8px;
letter-spacing: 5px;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 28px;
}
.closing-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(40px, 5vw, 70px);
font-weight: 300;
line-height: 1.2;
color: var(–white);
margin-bottom: 28px;
max-width: 700px;
margin-left: auto;
margin-right: auto;
}
.closing-title em { font-style: italic; color: var(–gold); }
.closing-body {
font-size: 13px;
line-height: 2;
color: var(–light);
max-width: 480px;
margin: 0 auto 52px;
}

/* Footer */
footer {
border-top: 1px solid var(–border);
padding: 32px 60px;
display: flex;
justify-content: space-between;
align-items: center;
}
.footer-logo {
font-family: ‘Cormorant Garamond’, serif;
font-size: 18px;
letter-spacing: 6px;
color: var(–gray);
}
.footer-note {
font-size: 9px;
letter-spacing: 2px;
color: var(–border);
text-transform: uppercase;
}

/* Animations */
@keyframes fadeUp {
from { opacity: 0; transform: translateY(24px); }
to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
from { opacity: 0; }
to { opacity: 1; }
}

/* Scroll reveal */
.reveal {
opacity: 0;
transform: translateY(30px);
transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal.visible {
opacity: 1;
transform: translateY(0);
}
.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }
</style>

</head>
